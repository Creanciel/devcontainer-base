{
  "name": "Default Dev Container",
  "dockerComposeFile": [
    "./docker/compose.yaml",
    "./docker/custom.compose.yaml"
  ],
  "service": "development",
  "initializeCommand": [
    "sh",
    "-c",
    "cd \"${localWorkspaceFolder}/.devcontainer/scripts\" || exit 1; [ -f initializeCommand.sh ] || cp initializeCommand.sample.sh initializeCommand.sh; sh initializeCommand.sh"
  ],
  "postStartCommand": [
    "sh",
    ".devcontainer/scripts/postStartCommand.sh"
  ],
  "workspaceFolder": "/devcontainer_base",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.cwd": "/devcontainer_base",
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#1f6feb",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#1f6feb99",
          "titleBar.inactiveForeground": "#ffffffcc"
        }
      },
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "mhutchie.git-graph"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  }
}
